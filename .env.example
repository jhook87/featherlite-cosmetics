# Copy this file to .env and fill in the appropriate values

# SQLite database used for development. In production, set to your Postgres connection string.
DATABASE_URL="file:./dev.db"

# Stripe secret key for payments. Obtain from your Stripe dashboard.
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"

# Stripe webhook secret (for verifying webhook signatures). Obtain after adding an endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxx"

# Stripe publishable key used client-side for Stripe.js if needed.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"

# Database provider ("sqlite" or "postgresql"). Prisma reads this variable to set provider in schema.
DATABASE_PROVIDER="sqlite"

# Base URL of your site. Used when constructing callback URLs (e.g. in checkout).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"